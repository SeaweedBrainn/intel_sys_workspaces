# Zenoh RMW environment for the intel_sys containers.
# Loaded by every service in docker-compose.robot.yml, including the router.
#
# RMW_IMPLEMENTATION       Selects the ROS 2 middleware. rmw_zenoh_cpp talks to the
#                          zenohd router below instead of doing DDS discovery.
# ZENOH_SESSION_CONFIG_URI Client session config (in-container path; the repo is
#                          mounted at /workspaces/intel_sys).
# ZENOH_ROUTER_CONFIG_URI  Config read by zenohd (the rmw_zenohd router process).
# ZENOH_ROUTER_CHECK_ATTEMPTS  How many times a node checks for the router before
#                          failing at startup (-1 = forever).
#
# ROS_AUTOMATIC_DISCOVERY_RANGE is intentionally unset:
# all nodes share one host with a router, so multicast discovery is not needed.

RMW_IMPLEMENTATION=rmw_zenoh_cpp
ZENOH_SESSION_CONFIG_URI=/workspaces/intel_sys/docker/zenoh/session.json5
ZENOH_ROUTER_CONFIG_URI=/workspaces/intel_sys/docker/zenoh/router.json5
ZENOH_ROUTER_CHECK_ATTEMPTS=5
