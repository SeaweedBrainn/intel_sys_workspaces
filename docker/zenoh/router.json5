// zenohd router for the robot (rmw_zenohd). Loopback only: all ROS nodes run on
// this host, so the router does not need to be reachable from the network.
{
  mode: "router",
  listen: {
    endpoints: ["tcp/127.0.0.1:7447"],
  },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },
}
