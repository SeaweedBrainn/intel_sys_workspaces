// rmw_zenoh_cpp client session config for the robot nodes.
// Base: upstream DEFAULT_RMW_ZENOH_SESSION_CONFIG.json5 (not verified in-container yet;
// check /opt/ros/humble/share/rmw_zenoh_cpp/config/ after the build).
// Overrides are kept to what matters for one host:
//  - connect to the local router only (no multicast scouting)
//  - shared memory OFF. It was meant to avoid copying large PointCloud2 / Image messages,
//    but on the Jetson every message above a few KB was silently dropped ("Unable to create
//    POSIX shm segment: OS error 12" in the router log), while small messages (IMU at 250 Hz)
//    still arrived. Measured 2026-11-23 with it off: RealSense colour and depth 15.1 Hz each,
//    LiDAR cloud 12.0 Hz, IMU 252 Hz. Re-test before turning it back on.
{
  mode: "client",
  connect: {
    endpoints: ["tcp/127.0.0.1:7447"],
  },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },
  transport: {
    shared_memory: { enabled: false },
  },
}
