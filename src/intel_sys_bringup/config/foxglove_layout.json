{
  "configById": {
    "3D!main": {
      "cameraState": {
        "perspective": true,
        "distance": 8.0,
        "phi": 55,
        "thetaOffset": 45,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.01,
        "far": 1000
      },
      "followMode": "follow-position",
      "followTf": "base_footprint",
      "displayFrame": "odom",
      "scene": {
        "enableStats": false,
        "meshUpAxis": "z_up",
        "transforms": {
          "showLabels": false,
          "axisScale": 0.3
        }
      },
      "transforms": {
        "showTransforms": false
      },
      "topics": {
        "/robot_description": {
          "visible": true
        },
        "/lidar/points": {
          "visible": true,
          "colorField": "z",
          "colorMode": "colormap",
          "colorMap": "turbo",
          "minValue": -0.2,
          "maxValue": 1.5,
          "pointSize": 2
        },
        "/map": {
          "visible": true
        },
        "/global_costmap/costmap": {
          "visible": true,
          "alpha": 0.4
        },
        "/local_costmap/costmap": {
          "visible": false,
          "alpha": 0.5
        },
        "/plan": {
          "visible": true
        },
        "/local_plan": {
          "visible": true
        },
        "/tag_follower/tag_pose": {
          "visible": true,
          "type": "arrow",
          "color": "#ff00ff"
        },
        "/tag_follower/goal": {
          "visible": true,
          "type": "arrow",
          "color": "#00ff88"
        },
        "/goal_pose": {
          "visible": true,
          "type": "arrow",
          "color": "#ffaa00"
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/goal_pose"
      }
    },
    "Image!camera": {
      "imageMode": {
        "imageTopic": "/camera/image_raw"
      },
      "imageTopic": "/camera/image_raw"
    },
    "DiagnosticSummary!health": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "sortByLevel": true
    },
    "CallService!followOn": {
      "serviceName": "/tag_follower/enable",
      "requestPayload": "{\"data\": true}",
      "layout": "vertical",
      "buttonText": "Follow tag: ON",
      "buttonColor": "#2e7d32",
      "buttonTooltip": "Start following ArUco tag 10 (scripts/robot.sh up follow)",
      "editingMode": false
    },
    "CallService!followOff": {
      "serviceName": "/tag_follower/enable",
      "requestPayload": "{\"data\": false}",
      "layout": "vertical",
      "buttonText": "Follow tag: OFF",
      "buttonColor": "#c62828",
      "buttonTooltip": "Stop following; cancels the Nav2 goal",
      "editingMode": false
    },
    "CallService!exploreStart": {
      "serviceName": "/frontier_explorer/start",
      "requestPayload": "{}",
      "layout": "vertical",
      "buttonText": "Explore: START",
      "buttonColor": "#1565c0",
      "buttonTooltip": "Frontier exploration on RTAB-Map's map (scripts/robot.sh up navigation)",
      "editingMode": false
    },
    "CallService!exploreStop": {
      "serviceName": "/frontier_explorer/stop",
      "requestPayload": "{}",
      "layout": "vertical",
      "buttonText": "Explore: STOP",
      "buttonColor": "#c62828",
      "buttonTooltip": "Stop exploring; cancels the Nav2 goal",
      "editingMode": false
    },
    "RawMessages!exploreState": {
      "topicPath": "/frontier_explorer/state.data",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false
    },
    "Teleop!drive": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": {
        "field": "linear-x",
        "value": 0.15
      },
      "downButton": {
        "field": "linear-x",
        "value": -0.15
      },
      "leftButton": {
        "field": "angular-z",
        "value": 0.5
      },
      "rightButton": {
        "field": "angular-z",
        "value": -0.5
      }
    },
    "Plot!battery": {
      "paths": [
        {
          "value": "/battery.data",
          "enabled": true,
          "label": "battery (raw board value)"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true
    },
    "RosOut!log": {
      "searchTerms": [],
      "minLogLevel": 3
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "splitPercentage": 60,
    "first": "3D!main",
    "second": {
      "direction": "column",
      "splitPercentage": 35,
      "first": "Image!camera",
      "second": {
        "direction": "column",
        "splitPercentage": 45,
        "first": {
          "direction": "row",
          "splitPercentage": 55,
          "first": "DiagnosticSummary!health",
          "second": {
            "direction": "column",
            "splitPercentage": 80,
            "first": {
              "direction": "column",
              "first": {
                "direction": "row",
                "first": "CallService!followOn",
                "second": "CallService!followOff"
              },
              "second": {
                "direction": "row",
                "first": "CallService!exploreStart",
                "second": "CallService!exploreStop"
              }
            },
            "second": "RawMessages!exploreState"
          }
        },
        "second": {
          "direction": "row",
          "splitPercentage": 40,
          "first": "Teleop!drive",
          "second": {
            "direction": "column",
            "first": "Plot!battery",
            "second": "RosOut!log"
          }
        }
      }
    }
  }
}