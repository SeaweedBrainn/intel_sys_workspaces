<?xml version="1.0" encoding="utf-8"?>
<robot name="intel_sys_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ==================== MATERIALS ==================== -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.1 0.8 0.1 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ==================== INERTIAL MACROS ==================== -->
  <xacro:macro name="box_inertial" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== PARAMETERS ==================== -->
  <xacro:property name="base_link_mass" value="1.6"/>
  <xacro:property name="base_link_w" value="0.297"/>
  <xacro:property name="base_link_h" value="0.145"/>
  <xacro:property name="base_link_d" value="0.11255"/>

  <xacro:property name="wheel_link_mass" value="0.1"/>
  <xacro:property name="wheel_link_radius" value="0.049"/>
  <xacro:property name="wheel_link_length" value="0.04167"/>

  <!-- ==================== CHASSIS & BASE ==================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.005" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:box_inertial m="${base_link_mass}" w="${base_link_w}" h="${base_link_h}" d="${base_link_d}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/base_link.stl"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="${base_link_w/2.0 - 0.14810} 0 ${0.126437/2 + 0.02362364}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_link_w} ${base_link_h} ${base_link_d}"/>
      </geometry>
    </collision>
  </link>

  <link name="back_shell_link">
    <inertial>
      <origin xyz="-1.228E-05 0.00218 -0.05005" rpy="0 0 0"/>
      <mass value="0.0663"/>
      <inertia ixx="5.65E-05" ixy="0.0" ixz="0.0" iyy="4.33E-05" iyz="0.0" izz="6.86E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/back_shell_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="back_shell_joint" type="fixed">
    <origin xyz="-0.076481 0 0.082796" rpy="-3.1416 0 1.5708"/>
    <parent link="base_link"/>
    <child link="back_shell_link"/>
  </joint>

  <!-- ==================== MECANUM WHEELS ==================== -->
  <!-- Front Right Wheel -->
  <link name="wheel_right_front_link">
    <xacro:cylinder_inertial m="${wheel_link_mass}" r="${wheel_link_radius}" h="${wheel_link_length}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/wheel_right_front_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_link_length/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_right_front_joint" type="continuous">
    <origin xyz="0.097397 -0.086125 0.04508" rpy="1.5708 1.5708 0"/>
    <parent link="base_link"/>
    <child link="wheel_right_front_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Front Left Wheel -->
  <link name="wheel_left_front_link">
    <xacro:cylinder_inertial m="${wheel_link_mass}" r="${wheel_link_radius}" h="${wheel_link_length}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/wheel_left_front_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -${wheel_link_length/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_left_front_joint" type="continuous">
    <origin xyz="0.097397 0.086125 0.04508" rpy="1.5708 1.5708 0"/>
    <parent link="base_link"/>
    <child link="wheel_left_front_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Back Right Wheel -->
  <link name="wheel_right_back_link">
    <xacro:cylinder_inertial m="${wheel_link_mass}" r="${wheel_link_radius}" h="${wheel_link_length}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/wheel_right_back_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_link_length/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_right_back_joint" type="continuous">
    <origin xyz="-0.097397 -0.086125 0.04508" rpy="1.5708 1.5708 0"/>
    <parent link="base_link"/>
    <child link="wheel_right_back_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Back Left Wheel -->
  <link name="wheel_left_back_link">
    <xacro:cylinder_inertial m="${wheel_link_mass}" r="${wheel_link_radius}" h="${wheel_link_length}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/wheel_left_back_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -${wheel_link_length/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_left_back_joint" type="continuous">
    <origin xyz="-0.097397 0.086125 0.04508" rpy="1.5708 1.5708 0"/>
    <parent link="base_link"/>
    <child link="wheel_left_back_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ==================== SENSORS ==================== -->
  <!-- IMU -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0867" rpy="0 0 ${-pi/2}"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- Unitree LiDAR L2 -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="-0.0157 0.0003 -0.0214" rpy="0 0 0"/>
      <mass value="0.052"/>
      <inertia ixx="1.45E-05" ixy="0.0" ixz="0.0" iyy="1.85E-05" iyz="0.0" izz="3.10E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/lidar_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.0959 0.0 0.1284" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- Intel RealSense Depth Camera -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0.00025 0.00268 -0.00569" rpy="0 0 0"/>
      <mass value="0.228"/>
      <inertia ixx="4.84E-05" ixy="0.0" ixz="0.0" iyy="4.08E-04" iyz="0.0" izz="4.29E-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/depth_camera_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://intel_sys_description/meshes/depth_camera_link_collision.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0288 0.0 0.2021" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Optical frames -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
  </joint>

</robot>
