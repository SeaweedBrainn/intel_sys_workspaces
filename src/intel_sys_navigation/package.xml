<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>intel_sys_navigation</name>
  <version>1.0.0</version>
  <description>Odometry publisher, EKF sensor fusion, Point-LIO SLAM, and Nav2 stack configuration</description>
  <maintainer email="aahil.aref@gmail.com">Aahil Shaikh</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>intel_sys_interfaces</depend>
  <depend>intel_sys_description</depend>
  <depend>robot_localization</depend>
  <depend>nav2_bringup</depend>
  <depend>navigation2</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
