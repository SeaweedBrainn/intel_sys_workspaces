#!/usr/bin/env python3
"""Frontier exploration: send Nav2 goals until no frontier is left, then drive home.

Once the map changes (RTAB-Map's /map, about once a second):
  1. Frontier chunks: free cells next to unknown, clustered, small clusters dropped,
     big ones split (intel_sys_navigation.frontiers).
  2. A viewpoint per chunk: the reachable spot that sees the most of its frontier
     cells within the sensors' front 180 degrees, and the heading to see them from.
     A chunk is only worth visiting if that view holds at least min_new_area of
     unknown space; that is also what ends exploration.
     Reachable means on Nav2's global costmap, through known cells cheaper than
     "inscribed", so every goal sent is one Nav2 can plan to.
     The current goal stays in the plan as it is (same spot and heading), and chunks
     one viewpoint already sees (cover_fraction of what their own viewpoint would)
     get no stop of their own.
  3. goal_strategy:=tour (default): the order of visiting all viewpoints, planned
     over path lengths and turns in seconds; the robot drives to the first stop, and
     only switches when another tour is more than switch_hysteresis cheaper.
     goal_strategy:=greedy: the viewpoint with the most unknown area per second.
  (intel_sys_navigation.tour for 2 and 3.)

A goal ends when the frontier it was sent for (its chunk and the chunks it covers)
has been mapped or no longer holds min_new_area (the next goal preempts it in Nav2), when
it is reached, fails, or takes three times its expected travel time; the last three
are blacklisted. With no frontier left it drives back to where it started (which also
lets RTAB-Map close the loop). Every goal sent is tracked until Nav2 reports its end,
so ~/stop and Ctrl-C cancel whatever is running. Only sends goals: Nav2 drives.

Travel times use Nav2's own top speed and turn rate, read at startup from the velocity
smoother (max_velocity), which every controller's output passes through, so they don't
depend on which controller runs.

    ros2 run intel_sys_navigation frontier_explorer --ros-args -p use_sim_time:=true

With wait_for_start:=true it stays idle until ~/start (std_srvs/Trigger, e.g. from
Foxglove's service call panel), returns to idle when done or on ~/stop, and keeps running.
~/state (std_msgs/String) reports idle, explore or home.
"""
import math
import signal
import time

import numpy as np
import rclpy
from action_msgs.msg import GoalStatus
from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import NavigateToPose
from nav_msgs.msg import OccupancyGrid
from rcl_interfaces.srv import GetParameters
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from rclpy.signals import SignalHandlerOptions
from rclpy.time import Time
from std_msgs.msg import String
from std_srvs.srv import Trigger
from tf2_ros import Buffer, TransformListener

from intel_sys_navigation.frontiers import Grid, frontier_chunks, still_frontier
from intel_sys_navigation.tour import (Candidate, PathGraph, best_viewpoint, leg_costs, merge, pick,
                                       seen_from, unknown_area)

SAME_GOAL = 0.3   # m: goals closer than this are the same goal


def grid(msg):
    return Grid(np.array(msg.data, dtype=np.int8).reshape(msg.info.height, msg.info.width),
                msg.info.resolution, (msg.info.origin.position.x, msg.info.origin.position.y))


class FrontierExplorer(Node):
    def __init__(self):
        super().__init__('frontier_explorer')
        p = self.declare_parameter
        self.min_size = p('min_frontier_cells', 8).value
        self.chunk_radius = p('chunk_radius', 1.5).value              # m: one viewpoint per chunk
        self.done_after = p('empty_checks_before_done', 5).value
        self.return_home = p('return_home', True).value
        self.wait_for_start = p('wait_for_start', False).value
        self.strategy = p('goal_strategy', 'tour').value
        # The L2 and the D435 face +x; the robot body blocks the rear half.
        self.fov = math.radians(p('sensor_fov_deg', 180.0).value)
        self.view_range = p('view_range', 5.0).value                  # m: frontier cells counted as seen
        # A visit must reveal at least this much unknown area (in view from the viewpoint).
        # Cost-benefit, not physics: smaller slivers (corners, behind furniture) cost a trip
        # each and often can't be mapped at all. 2.0 came from the sim (office.sdf, where
        # without it the robot spent 6 minutes on slivers); tune it on the robot.
        self.min_new_area = p('min_new_area', 2.0).value             # m^2
        self.hysteresis = p('switch_hysteresis', 0.15).value
        # A viewpoint covers another chunk when it sees this fraction of what that chunk's
        # own viewpoint would; covered chunks get no stop of their own.
        self.cover_fraction = p('cover_fraction', 0.8).value
        self.blacklist_radius = p('blacklist_radius', 0.5).value
        # Goals only on global-costmap cells this cheap (0-98 scale): with our inflation
        # (0.55 m, fall-off 5) 30 is about 0.45 m from obstacles, room to stop and turn.
        self.goal_max_cost = p('goal_max_cost', 30).value
        # No goals nearer the robot than this: a goal 0.46 m away left it stuck until Nav2's
        # progress checker (0.5 m in 10 s) aborted it (sim, 2026-11-26), and from that close
        # the sensors already see the frontier.
        self.min_goal_distance = p('min_goal_distance', 0.6).value
        # A goal fails after timeout_factor x its expected travel time (at least min_goal_timeout).
        self.timeout_factor = p('timeout_factor', 3.0).value
        self.min_timeout = p('min_goal_timeout', 30.0).value
        self.smoother = p('velocity_smoother', 'velocity_smoother').value
        # Used until Nav2's own values are read (and if it doesn't have them).
        self.limits = {'speed': 0.2, 'turn_rate': 0.6}
        self.limits_read = False

        self.map = self.costmap = None
        self.map_changed = False
        self.tf = Buffer()
        TransformListener(self.tf, self)
        latched = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL,
                             reliability=ReliabilityPolicy.RELIABLE)
        self.create_subscription(OccupancyGrid, '/map', self.on_map, latched)
        self.create_subscription(OccupancyGrid, p('costmap_topic', '/global_costmap/costmap').value,
                                 self.on_costmap, latched)
        self.nav = ActionClient(self, NavigateToPose, 'navigate_to_pose')
        self.params = self.create_client(GetParameters, f'/{self.smoother}/get_parameters')
        self.state_pub = self.create_publisher(String, '~/state', latched)
        self.create_service(Trigger, '~/start', self.on_start)
        self.create_service(Trigger, '~/stop', self.on_stop)
        self.active = {}      # goal id -> handle, for every goal Nav2 accepted and hasn't finished
        self.seq = 0          # id of the latest goal sent
        self.reset()
        self.set_state('idle' if self.wait_for_start else 'explore')   # explore -> home -> done/idle
        self.create_timer(1.0, self.step)

    # ---- session state ----

    def reset(self):
        """Fresh session: new home, empty blacklist and stats."""
        self.home = None
        self.goal = self.goal_handle = None
        self.goal_yaw = 0.0
        self.targets = []     # one frontier cell per chunk the current goal was sent to see
        self.deadline = None
        self.blacklist = []
        self.empty = 0
        self.stats = {'goals': 0, 'reached': 0, 'failed': 0, 'replaced': 0, 'switched': 0}

    def set_state(self, state):
        self.state = state
        self.state_pub.publish(String(data=state))

    def end(self):
        """Exploration over: idle (and keep running) when started by service, else done."""
        self.set_state('idle' if self.wait_for_start else 'done')

    def on_start(self, _req, res):
        if self.state in ('explore', 'home'):
            res.success, res.message = False, f'already running ({self.state})'
            return res
        self.reset()
        self.set_state('explore')
        res.success, res.message = True, 'exploring'
        self.get_logger().info('started')
        return res

    def on_stop(self, _req, res):
        was = self.state
        self.cancel_all()
        self.end()
        res.success, res.message = True, f'stopped ({was}); {self.stats}'
        self.get_logger().info(res.message)
        return res

    def on_map(self, msg):
        self.map = msg
        self.map_changed = True

    def on_costmap(self, msg):
        self.costmap = msg

    # ---- Nav2's limits ----

    def read_limits(self):
        """Top forward speed and turn rate from Nav2's velocity smoother ([vx, vy, wz])."""
        if self.limits_read or not self.params.service_is_ready():
            return

        def done(fut):
            vals = fut.result().values if fut.result() else []
            v = list(vals[0].double_array_value) if vals and vals[0].type == 8 else []
            if len(v) == 3 and v[0] > 0 and v[2] > 0:
                self.limits = {'speed': v[0], 'turn_rate': v[2]}
            self.limits_read = True
            self.get_logger().info(f'Nav2 limits for travel times: {self.limits} '
                                   f'({"read from " + self.smoother if len(v) == 3 else "defaults"})')
        self.params.call_async(GetParameters.Request(names=['max_velocity'])).add_done_callback(done)

    # ---- goals ----

    def pose(self):
        try:
            t = self.tf.lookup_transform('map', 'base_footprint', Time())
        except Exception:  # noqa: BLE001 (TF not ready yet)
            return None
        q = t.transform.rotation
        yaw = math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))
        return (t.transform.translation.x, t.transform.translation.y), yaw

    def send(self, xy, yaw, timeout):
        """Send a goal; it preempts any running one in Nav2 (no cancel first: a cancel sent
        just before the new goal sometimes cancelled the new goal, sim 2026-11-24)."""
        g = NavigateToPose.Goal()
        g.pose = PoseStamped()
        g.pose.header.frame_id = 'map'
        g.pose.header.stamp = self.get_clock().now().to_msg()
        g.pose.pose.position.x, g.pose.pose.position.y = xy
        g.pose.pose.orientation.z, g.pose.pose.orientation.w = math.sin(yaw / 2), math.cos(yaw / 2)
        self.seq += 1
        seq = self.seq
        self.goal, self.goal_yaw, self.goal_handle = xy, yaw, None
        self.deadline = time.monotonic() + timeout
        self.nav.send_goal_async(g).add_done_callback(lambda f: self.on_accepted(f, seq))

    def on_accepted(self, fut, seq):
        h = fut.result()
        if not h.accepted:
            if seq == self.seq:
                self.finish(False, 'rejected')
            return
        self.active[bytes(h.goal_id.uuid)] = h
        h.get_result_async().add_done_callback(lambda f: self.on_result(h, f.result().status))
        if seq != self.seq or self.goal is None:
            h.cancel_goal_async()     # superseded or stopped while it was being sent
        else:
            self.goal_handle = h

    def on_result(self, h, status):
        self.active.pop(bytes(h.goal_id.uuid), None)
        if h is self.goal_handle:
            self.finish(status == GoalStatus.STATUS_SUCCEEDED, f'status {status}')

    def finish(self, ok, why):
        if self.state == 'home':
            self.get_logger().info(f'back home ({why}); exploration done: {self.stats}')
            self.end()
        elif self.goal is not None:
            # Blacklisted either way: a reached viewpoint whose frontier is still there
            # can't be mapped from there (dark or shiny surfaces, beyond the map's range).
            self.stats['reached' if ok else 'failed'] += 1
            self.blacklist.append(self.goal)
            if not ok:
                self.get_logger().warn(f'goal {self.goal[0]:.2f}, {self.goal[1]:.2f} failed ({why}); blacklisted')
        self.goal = self.goal_handle = None

    def cancel_all(self):
        """Cancel every goal Nav2 is still running for us (including superseded ones)."""
        for h in list(self.active.values()):
            h.cancel_goal_async()
        self.seq += 1   # a goal still being sent is cancelled when Nav2 accepts it
        self.goal = self.goal_handle = None

    # ---- the loop ----

    def current_goal(self, m, chunks):
        """The goal being driven to, as a candidate at its own spot and heading, or None
        once what it was sent to see is mapped or no longer worth min_new_area.

        Kept as it is rather than matched to this update's chunks: chunks are recomputed
        and split differently as the map grows, and matching by chunk lost the current
        goal, skipped the hysteresis and flipped between goals (office.sdf, 2026-11-26).
        """
        if self.goal is None:
            return None
        left = [t for t in self.targets if still_frontier(chunks, t)]
        if not left:
            return None
        own = min(chunks, key=lambda ch: min(np.min(np.hypot(*(ch.cells - np.asarray(t)).T)) for t in left))
        area = unknown_area(m, self.goal, self.goal_yaw, self.fov, self.view_range)
        if area < self.min_new_area:
            return None
        seen = seen_from(m, self.goal, self.goal_yaw, own.cells, self.fov, self.view_range)
        return Candidate(own, self.goal, seen, self.goal_yaw, area)

    def plan(self, xy, yaw):
        """(chunks, candidates, cost, current, covered): viewpoints to visit, the (k+1, k+1)
        cost matrix with the robot first, the current goal's index in it (1-based) or None,
        and for each candidate the chunks it covers."""
        m, cm = grid(self.map), grid(self.costmap)
        chunks = frontier_chunks(m, self.min_size, self.chunk_radius)
        graph = PathGraph(cm)
        from_robot = graph.distances_from(xy)
        skip = [(b, self.blacklist_radius) for b in self.blacklist] + [(xy, self.min_goal_distance)]
        cands = [c for c in (best_viewpoint(ch, m, graph, from_robot, self.fov, self.view_range, skip,
                                            self.goal_max_cost)
                             for ch in chunks) if c is not None and c.new_area >= self.min_new_area]
        cur = self.current_goal(m, chunks)
        if cur is not None:
            cands.insert(0, cur)
        if not cands:
            return chunks, [], None, None, []
        keep, covers = merge(cands, m, self.fov, self.view_range, self.cover_fraction,
                             first=0 if cur is not None else None)
        covered = [[cands[j].chunk for j in cov] for cov in covers]
        cands = [cands[i] for i in keep]
        dist, depart, arrive = graph.legs([xy] + [c.xy for c in cands])
        cost = leg_costs(dist, depart, arrive, [yaw] + [c.heading for c in cands],
                         self.limits['speed'], self.limits['turn_rate'])
        return chunks, cands, cost, (1 if cur is not None else None), covered

    def step(self):
        self.read_limits()
        if self.state in ('done', 'idle') or self.map is None or self.costmap is None:
            return
        p = self.pose()
        if p is None:
            return
        xy, yaw = p
        if self.home is None:
            self.home = (xy, yaw)
            self.get_logger().info(f'home at {xy[0]:.2f}, {xy[1]:.2f}')
        if self.state == 'home':
            return
        if not self.nav.server_is_ready():
            self.get_logger().info('waiting for navigate_to_pose', throttle_duration_sec=10)
            return
        if self.goal is not None and self.goal_handle is None:
            return  # waiting for Nav2 to accept the last goal
        if self.goal is not None and time.monotonic() > self.deadline:
            self.get_logger().warn('goal took too long')
            self.finish(False, 'timeout')   # the next goal preempts it, or cancel_all below
        if self.goal is not None and not self.map_changed:
            return
        self.map_changed = False

        t0 = time.monotonic()
        chunks, cands, cost, current, covered = self.plan(xy, yaw)
        if self.goal is not None and current is None:
            self.stats['replaced'] += 1
            self.get_logger().info('frontier mapped before arrival; picking the next one')
            self.goal = None    # its handle stays tracked until the next goal preempts it
        if not cands:
            self.cancel_all()   # nothing to drive to: stop whatever Nav2 is still doing
            self.empty += 1
            if self.empty >= self.done_after:
                self.get_logger().info(f'no frontiers left; {self.stats}')
                if self.return_home:
                    self.set_state('home')
                    self.send(*self.home, timeout=float('inf'))
                else:
                    self.end()
            return
        self.empty = 0

        if self.strategy == 'tour':
            nxt, order, switched = pick(cost, current, self.hysteresis)
        else:   # greedy: most unknown area per second of travel
            nxt = 1 + int(np.argmax([c.new_area / max(cost[0, i + 1], 1e-3) for i, c in enumerate(cands)]))
            order, switched = [nxt], current is not None and nxt != current
        c = cands[nxt - 1]
        # What this goal is for: a frontier cell in each chunk it covers. Updated when the
        # goal is kept too, so it lasts while anything it now covers is unmapped.
        self.targets = [tuple(ch.cells[np.argmin(np.hypot(*(ch.cells - ch.centroid).T))])
                        for ch in covered[nxt - 1]]
        if self.goal is not None and (nxt == current or math.dist(c.xy, self.goal) < SAME_GOAL):
            return  # keep the current goal; resending it would restart Nav2 for nothing
        if switched:
            self.stats['switched'] += 1
        self.stats['goals'] += 1
        travel = float(cost[0, nxt])
        self.send(c.xy, c.heading, max(self.min_timeout, self.timeout_factor * travel))
        total = sum(cost[a, b] for a, b in zip([0] + order, order))
        self.get_logger().info(
            f'goal {self.stats["goals"]}: {c.xy[0]:.2f}, {c.xy[1]:.2f}, heading {math.degrees(c.heading):.0f} deg, '
            f'sees {c.gain} frontier cells and {c.new_area:.1f} m2 unknown, {travel:.0f} s away; '
            f'covers {len(covered[nxt - 1])} of {len(chunks)} chunks; {len(cands)} stops, tour {total:.0f} s'
            f'{" (switched)" if switched else ""}; planned in {1000 * (time.monotonic() - t0):.0f} ms')


def main():
    # Our own SIGINT/SIGTERM handler: rclpy's would shut the context down before the
    # cancel below reaches Nav2, and a KeyboardInterrupt can land inside a callback.
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
    node = FrontierExplorer()
    stop = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stop.append(True))
    try:
        while rclpy.ok() and node.state != 'done' and not stop:
            rclpy.spin_once(node, timeout_sec=0.5)
        if stop:
            node.get_logger().info(f'stopped; cancelling Nav2 goals. {node.stats}')
            node.cancel_all()
            for _ in range(4):
                rclpy.spin_once(node, timeout_sec=0.1)
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
