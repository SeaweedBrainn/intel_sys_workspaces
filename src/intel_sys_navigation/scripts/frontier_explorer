#!/usr/bin/env python3
"""Frontier exploration: send Nav2 goals to the edge of the known map until none are left.

Reads RTAB-Map's /map and the robot pose (map -> base_footprint), chooses a frontier
and sends it to Nav2's navigate_to_pose. With goal_strategy:=tour (the default; see
intel_sys_navigation.tour) each frontier gets the unknown area its goal would show the
front-facing sensors and a heading that faces it; the visiting order of all of them is
planned over real path lengths and turns, and the robot drives to the first stop. The
tour is re-planned each second, and the goal only changes when another tour is more
than switch_hysteresis cheaper. Frontiers that would reveal less than min_gain m^2
don't count, which is also what ends exploration. goal_strategy:=greedy picks the best
single frontier instead (large, near, ahead; see intel_sys_navigation.frontiers).

Only frontiers the robot can reach through known free space count, and Nav2's
planner must find a path to a goal before it is sent; goals without one are
blacklisted at once. When several goals in a row are refused, the robot itself is
probably boxed in (e.g. inside an obstacle's inflation): those goals are released
and the next one goes to Nav2, whose recoveries can free the robot. A goal is
dropped and re-picked when its frontier has been mapped; a goal that is reached,
fails or takes too long is blacklisted. With no frontiers left it drives back to
where it started (which also lets RTAB-Map close the loop) and exits. Only sends
goals: Nav2 drives, and cancelling the goal stops it.

    ros2 run intel_sys_navigation frontier_explorer --ros-args -p use_sim_time:=true

With wait_for_start:=true it stays idle until ~/start (std_srvs/Trigger, e.g. from
Foxglove's service call panel), returns to idle when done or on ~/stop, and keeps running.
~/state (std_msgs/String) reports idle, explore or home.
"""
import math
import signal
import time

import rclpy
from action_msgs.msg import GoalStatus
from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import ComputePathToPose, NavigateToPose
from nav_msgs.msg import OccupancyGrid
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from rclpy.signals import SignalHandlerOptions
from rclpy.time import Time
from std_msgs.msg import String
from std_srvs.srv import Trigger
from tf2_ros import Buffer, TransformListener

import numpy as np

from intel_sys_navigation.frontiers import choose, find_frontiers, still_frontier, target_cell, usable
from intel_sys_navigation.tour import PathGraph, candidates, leg_costs, pick

SAME_GOAL = 0.3   # m: goals closer than this are the same goal


class FrontierExplorer(Node):
    def __init__(self):
        super().__init__('frontier_explorer')
        self.min_size = self.declare_parameter('min_frontier_cells', 8).value
        self.goal_timeout = self.declare_parameter('goal_timeout', 90.0).value
        self.done_after = self.declare_parameter('empty_checks_before_done', 5).value
        self.return_home = self.declare_parameter('return_home', True).value
        self.wait_for_start = self.declare_parameter('wait_for_start', False).value
        self.strategy = self.declare_parameter('goal_strategy', 'tour').value
        # The L2 and the D435 face +x; the robot body blocks the rear half.
        self.fov = math.radians(self.declare_parameter('sensor_fov_deg', 180.0).value)
        self.gain_range = self.declare_parameter('gain_range', 5.0).value          # m
        self.min_gain = self.declare_parameter('min_gain', 2.0).value              # m^2
        # Seconds per metre and per radian in the tour's costs: Nav2's max_speed_xy and
        # the Rotation Shim's rotate_to_heading_angular_vel.
        self.speed = self.declare_parameter('tour_speed', 0.2).value               # m/s
        self.turn_rate = self.declare_parameter('tour_turn_rate', 0.5).value       # rad/s
        self.hysteresis = self.declare_parameter('switch_hysteresis', 0.15).value
        self.path_cell = self.declare_parameter('path_cell', 0.15).value           # m
        self.refusals_before_recovery = self.declare_parameter('refusals_before_recovery', 3).value
        self.map = None
        self.tf = Buffer()
        TransformListener(self.tf, self)
        qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL,
                         reliability=ReliabilityPolicy.RELIABLE)
        self.create_subscription(OccupancyGrid, '/map', self.on_map, qos)
        self.nav = ActionClient(self, NavigateToPose, 'navigate_to_pose')
        self.planner = ActionClient(self, ComputePathToPose, 'compute_path_to_pose')
        self.checking = False     # waiting for the planner's answer on a candidate goal
        self.sent_at = None
        self.state_pub = self.create_publisher(String, '~/state', QoSProfile(
            depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL, reliability=ReliabilityPolicy.RELIABLE))
        self.create_service(Trigger, '~/start', self.on_start)
        self.create_service(Trigger, '~/stop', self.on_stop)
        self.reset()
        self.set_state('idle' if self.wait_for_start else 'explore')   # explore -> home -> done/idle
        self.create_timer(1.0, self.step)

    def reset(self):
        """Fresh session: new home, empty blacklist and stats."""
        self.home = None
        self.goal = self.target = self.goal_handle = None
        self.blacklist = []
        self.refused = []         # goals the planner refused since its last success
        self.empty = 0
        self.stats = {'goals': 0, 'reached': 0, 'failed': 0, 'replaced': 0, 'switched': 0, 'no_path': 0,
                      'recoveries': 0}

    def set_state(self, state):
        self.state = state
        self.state_pub.publish(String(data=state))

    def end(self):
        """Exploration over: idle (and keep running) when started by service, else done."""
        self.set_state('idle' if self.wait_for_start else 'done')

    def on_start(self, _req, res):
        if self.state in ('explore', 'home'):
            res.success, res.message = False, f'already running ({self.state})'
            return res
        self.reset()
        self.set_state('explore')
        res.success, res.message = True, 'exploring'
        self.get_logger().info('started')
        return res

    def on_stop(self, _req, res):
        was = self.state
        self.cancel()
        self.end()
        res.success, res.message = True, f'stopped ({was}); {self.stats}'
        self.get_logger().info(res.message)
        return res

    def on_map(self, msg):
        self.map = msg

    def pose(self):
        try:
            t = self.tf.lookup_transform('map', 'base_footprint', Time())
        except Exception:  # noqa: BLE001 (TF not ready yet)
            return None
        q = t.transform.rotation
        yaw = math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))
        return (t.transform.translation.x, t.transform.translation.y), yaw

    def grid(self):
        m = self.map
        grid = np.array(m.data, dtype=np.int8).reshape(m.info.height, m.info.width)
        return grid, m.info.resolution, (m.info.origin.position.x, m.info.origin.position.y)

    def plan_tour(self, fronts, grid, res, origin, xy, yaw):
        """Next stop of the planned tour: (frontier, heading, note), 'keep' or None.

        'keep' means the current goal is still the one to drive to. None means no
        frontier is worth visiting.
        """
        t0 = time.monotonic()
        fronts = [f for f in fronts if usable(f, xy, self.blacklist)]
        cands = candidates(fronts, grid, res, origin, self.fov, self.gain_range, self.min_gain)
        if not cands:
            return None
        graph = PathGraph(grid, res, origin, cell=self.path_cell)
        dist, depart, arrive = graph.legs([xy] + [c.frontier.goal for c in cands])
        keep = [0] + [i + 1 for i in range(len(cands)) if np.isfinite(dist[0, i + 1])]
        if len(keep) == 1:
            return None
        cands = [cands[i - 1] for i in keep[1:]]
        sub = np.ix_(keep, keep)
        cost = leg_costs(dist[sub], depart[sub], arrive[sub], [yaw] + [c.heading for c in cands],
                         self.speed, self.turn_rate)
        current = None
        if self.goal is not None:
            # Two clusters can share a goal point (the nearest clear cell to each), so
            # match the goal itself first, then the frontier cell being watched.
            current = next((i + 1 for i, c in enumerate(cands)
                            if math.dist(c.frontier.goal, self.goal) < SAME_GOAL), None)
            if current is None:
                current = next((i + 1 for i, c in enumerate(cands)
                                if still_frontier([c.frontier], self.target)), None)
        nxt, order, switched = pick(cost, current, self.hysteresis)
        if self.goal is not None and (nxt == current or
                                      math.dist(cands[nxt - 1].frontier.goal, self.goal) < SAME_GOAL):
            return 'keep'   # resending the same goal would restart Nav2 for nothing
        if switched:
            self.stats['switched'] += 1
        elif self.goal is not None and current is None:
            self.stats['replaced'] += 1   # its frontier no longer reveals enough
        total = sum(cost[a, b] for a, b in zip([0] + order, order))
        c = cands[nxt - 1]
        note = (f'gain {c.gain:.1f} m2, {cost[0, nxt]:.0f} s away; tour of {len(order)} stops, '
                f'{total:.0f} s{" (switched)" if switched else ""}; '
                f'planned in {1000 * (time.monotonic() - t0):.0f} ms')
        return c.frontier, c.heading, note

    def pose_stamped(self, xy, yaw):
        p = PoseStamped()
        p.header.frame_id = 'map'
        p.header.stamp = self.get_clock().now().to_msg()
        p.pose.position.x, p.pose.position.y = xy
        p.pose.orientation.z, p.pose.orientation.w = math.sin(yaw / 2), math.cos(yaw / 2)
        return p

    def check_then_send(self, xy, yaw):
        """Send the goal only if Nav2's planner finds a path to it (answers in well under a second)."""
        if not self.planner.server_is_ready():
            self.send(xy, yaw)
            return
        g = ComputePathToPose.Goal()
        g.goal = self.pose_stamped(xy, yaw)
        g.use_start = False
        self.checking = True

        def on_result(fut):
            self.checking = False
            res = fut.result()
            if res.status == GoalStatus.STATUS_SUCCEEDED and res.result.path.poses:
                self.refused = []
                self.send(xy, yaw)
                return
            self.stats['no_path'] += 1
            self.refused.append(xy)
            if len(self.refused) < self.refusals_before_recovery:
                self.blacklist.append(xy)
                self.get_logger().warn(f'no path to {xy[0]:.2f}, {xy[1]:.2f}; blacklisted')
                return
            # Several different goals refused in a row: more likely the robot can't plan
            # from where it stands (e.g. inside an obstacle's inflation) than that all of
            # them are unreachable. Un-blacklist them and let navigate_to_pose's recoveries
            # (clear costmaps, spin, wait) free the robot; if that goal fails, it is
            # blacklisted as usual.
            self.blacklist = [b for b in self.blacklist if b not in self.refused]
            self.refused = []
            self.stats['recoveries'] += 1
            self.get_logger().warn(f'planner refused {self.refusals_before_recovery} goals in a row; '
                                   f'sending {xy[0]:.2f}, {xy[1]:.2f} to Nav2 to recover')
            self.send(xy, yaw)

        def on_accepted(fut):
            h = fut.result()
            if not h.accepted:
                self.checking = False
                self.send(xy, yaw)  # planner busy: let navigate_to_pose decide
                return
            h.get_result_async().add_done_callback(on_result)

        self.planner.send_goal_async(g).add_done_callback(on_accepted)

    def send(self, xy, yaw):
        g = NavigateToPose.Goal()
        g.pose = self.pose_stamped(xy, yaw)
        self.goal, self.sent_at, self.goal_handle = xy, self.get_clock().now(), None
        self.nav.send_goal_async(g).add_done_callback(self.on_accepted)

    def on_accepted(self, fut):
        h = fut.result()
        if not h.accepted:
            self.finish(False, 'rejected')
            return
        self.goal_handle = h
        h.get_result_async().add_done_callback(
            lambda f, h=h: self.on_result(h, f.result().status))

    def on_result(self, h, status):
        if h is not self.goal_handle:
            return  # an old goal we already replaced
        self.finish(status == GoalStatus.STATUS_SUCCEEDED, f'status {status}')

    def finish(self, ok, why):
        if self.state == 'home':
            self.get_logger().info(f'back home ({why}); exploration done: {self.stats}')
            self.end()
        elif ok and self.goal is not None:
            # Seen from there: don't come back to the same spot if unknown space is left
            # that the sensors can't fill (dark or shiny surfaces, beyond the map's range).
            self.stats['reached'] += 1
            self.blacklist.append(self.goal)
        elif self.goal is not None:
            self.stats['failed'] += 1
            self.blacklist.append(self.goal)
            self.get_logger().warn(f'goal {self.goal[0]:.2f}, {self.goal[1]:.2f} failed ({why}); blacklisted')
        self.goal = self.goal_handle = None

    def cancel(self):
        if self.goal_handle is not None:
            self.goal_handle.cancel_goal_async()
        self.goal = self.goal_handle = None

    def step(self):
        if self.state in ('done', 'idle') or self.map is None:
            return
        p = self.pose()
        if p is None:
            return
        xy, yaw = p
        if self.home is None:
            self.home = (xy, yaw)
            self.get_logger().info(f'home at {xy[0]:.2f}, {xy[1]:.2f}')
        if self.state == 'home' or self.checking or (self.goal is not None and self.goal_handle is None):
            return  # driving home, or waiting for the planner or Nav2
        if not self.nav.server_is_ready():
            self.get_logger().info('waiting for navigate_to_pose', throttle_duration_sec=10)
            return
        grid, res, origin = self.grid()
        fronts = find_frontiers(grid, res, origin, self.min_size, robot_xy=xy)
        if self.goal is not None:
            age = (self.get_clock().now() - self.sent_at).nanoseconds * 1e-9
            if age > self.goal_timeout:
                self.blacklist.append(self.goal)
                self.stats['failed'] += 1
                self.get_logger().warn(f'goal timed out after {age:.0f} s; blacklisted')
                self.cancel()
            elif not still_frontier(fronts, self.target):
                self.stats['replaced'] += 1
                self.get_logger().info('frontier mapped before arrival; picking the next one')
                # No cancel: the next goal preempts this one in Nav2. A cancel sent just
                # before the new goal could cancel the new goal instead (seen in the sim).
                self.goal = self.goal_handle = None
            elif self.strategy != 'tour':
                return
        if self.strategy == 'tour':
            nxt = self.plan_tour(fronts, grid, res, origin, xy, yaw)
            if nxt == 'keep':
                return
            if nxt is not None and self.goal is not None:
                # Switching goals. No cancel: the new goal preempts this one (see above).
                self.goal = self.goal_handle = None
        else:
            best = choose(fronts, xy, yaw, self.blacklist)
            nxt = None if best is None else (
                best, math.atan2(best.goal[1] - xy[1], best.goal[0] - xy[0]), '')
        if nxt is None and self.goal is not None:
            return  # nothing worth switching to: keep driving to the current goal
        if nxt is None:
            self.empty += 1
            if self.empty >= self.done_after:
                self.get_logger().info(f'no frontiers left; {self.stats}')
                if self.return_home:
                    self.set_state('home')
                    self.send(*self.home)
                else:
                    self.end()
            return
        self.empty = 0
        best, heading, note = nxt
        self.target = target_cell(best)
        self.stats['goals'] += 1
        self.get_logger().info(
            f'frontier {self.stats["goals"]}: {best.size} cells, goal {best.goal[0]:.2f}, {best.goal[1]:.2f}, '
            f'heading {math.degrees(heading):.0f} deg ({len(fronts)} frontiers){"; " + note if note else ""}')
        self.check_then_send(best.goal, heading)


def main():
    # Our own SIGINT/SIGTERM handler: rclpy's would shut the context down before the
    # cancel below reaches Nav2, and a KeyboardInterrupt can land inside a callback.
    rclpy.init(signal_handler_options=SignalHandlerOptions.NO)
    node = FrontierExplorer()
    stop = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stop.append(True))
    try:
        while rclpy.ok() and node.state != 'done' and not stop:
            rclpy.spin_once(node, timeout_sec=0.5)
        if stop:
            node.get_logger().info(f'stopped; cancelling the Nav2 goal. {node.stats}')
            node.cancel()
            for _ in range(4):
                rclpy.spin_once(node, timeout_sec=0.1)
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
