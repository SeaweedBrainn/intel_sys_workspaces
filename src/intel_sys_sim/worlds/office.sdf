        <visual name="vis"><geometry><box><size>3.40 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_south_0">
      <static>true</static>
      <pose>-9.05 -1.10 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.90 0.20 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.90 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
