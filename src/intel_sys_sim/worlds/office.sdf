<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="intel_sys_office">
    <!-- Physics parameters -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Office world for exploration tests: a 22 x 2 m corridor with three rooms
         on each side (doors 1.2 m wide, walls 2 m tall so the LiDAR can't see over
         them). Start at the west end of the corridor, e.g. x=-9.5 y=0. -->
    <model name="outer_north_0">
      <static>true</static>
      <pose>0.00 7.10 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22.40 0.20 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>22.40 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_south_0">
      <static>true</static>
      <pose>0.00 -7.10 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22.40 0.20 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>22.40 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_west">
      <static>true</static>
      <pose>-11.10 0.00 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.20 14.00 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.20 14.00 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="outer_east">
      <static>true</static>
      <pose>11.10 0.00 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.20 14.00 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.20 14.00 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_north_0">
      <static>true</static>
      <pose>-9.55 1.10 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.90 0.20 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.90 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_north_1">
      <static>true</static>
      <pose>-4.00 1.10 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.80 0.20 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.80 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_north_2">
      <static>true</static>
      <pose>3.25 1.10 1.00 0 0 0.0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6.30 0.20 2.00</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.30 0.20 2.00</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="corridor_north_3">
      <static>true</static>
      <pose>9.30 1.10 1.00 0 0 0.0</pose>
